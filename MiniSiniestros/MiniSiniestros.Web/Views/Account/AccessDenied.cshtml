@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="card shadow border-0 mx-auto rounded-3" style="max-width: 500px;">
        <div class="card-body p-5">
            <i class="bi bi-shield-slash text-danger display-1 mb-3"></i>
            <h2 class="text-danger fw-bold">Acceso Denegado</h2>
            <p class="text-muted">No tienes los permisos requeridos o el rol necesario para realizar esta acción en el sistema.</p>
            <hr class="my-4" />
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-house me-1"></i>Volver al Inicio
            </a>
        </div>
    </div>
</div>
