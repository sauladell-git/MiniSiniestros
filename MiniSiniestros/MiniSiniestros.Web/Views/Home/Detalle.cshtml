@model MiniSiniestros.ViewModels.Siniestros.SiniestroDetailViewModel

@{
    ViewData["Title"] = $"Detalle del Siniestro #{Model.Numero}";
    
    var badgeClass = Model.SiniestroEstado?.Id switch
    {
        1 => "bg-info text-dark",       // Recibido
        2 => "bg-warning text-dark",    // EnAnalisis
        3 => "bg-success text-white",   // Aprobado
        4 => "bg-danger text-white",    // Rechazado
        5 => "bg-secondary text-white", // Cerrado
        _ => "bg-dark text-white"
    };
}

<div class="container py-4">
    <!-- Header de Navegación -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 text-primary font-weight-bold mb-1">
                <i class="bi bi-file-earmark-text me-2"></i>Siniestro #@Model.Numero
            </h1>
            <p class="text-muted mb-0">Detalle completo de la solicitud de siniestro y su historial.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge @badgeClass px-3 py-2 fs-5 shadow-sm">
                @Model.SiniestroEstado?.Nombre
            </span>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver al Listado
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Card 1: Información General del Siniestro -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>Información General
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">ID de Registro:</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Número Siniestro:</dt>
                        <dd class="col-sm-8 fw-bold text-primary">#@Model.Numero</dd>

                        <dt class="col-sm-4 text-muted">Fecha de Ocurrencia:</dt>
                        <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss") UTC</dd>

                        <dt class="col-sm-4 text-muted">Estado Actual:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @badgeClass px-2 py-1">@Model.SiniestroEstado?.Nombre</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Observaciones:</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones registradas." : Model.Observaciones)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Card 2: Empleador y Trabajador -->
        <div class="col-md-6">
            <div class="row g-4">
                <!-- Datos del Empleador -->
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-dark text-white py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-building me-2"></i>Datos del Empleador
                            </h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Razón Social:</dt>
                                <dd class="col-sm-8 fw-bold">@(Model.Empleador?.RazonSocial ?? "-")</dd>

                                <dt class="col-sm-4 text-muted">CUIT:</dt>
                                <dd class="col-sm-8">@(Model.Empleador?.Cuit ?? "-")</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Datos del Trabajador -->
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-secondary text-white py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-person-badge-fill me-2"></i>Datos del Trabajador
                            </h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Nombre Completo:</dt>
                                <dd class="col-sm-8 fw-bold">@(Model.Trabajador != null ? $"{Model.Trabajador.Nombre} {Model.Trabajador.Apellido}" : "-")</dd>

                                <dt class="col-sm-4 text-muted">CUIL:</dt>
                                <dd class="col-sm-8">@(Model.Trabajador?.Cuil ?? "-")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Prestadores Médicos Asignados -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 text-secondary fw-bold">
                        <i class="bi bi-hospital me-2"></i>Prestadores Médicos Asignados
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Prestadores.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-heart-pulse fs-2 d-block mb-1 text-secondary"></i>
                            Sin prestadores asignados a este siniestro.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var prestador in Model.Prestadores)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@prestador.Nombre</h6>
                                        <small class="text-muted">ID Prestador: #@prestador.Id</small>
                                    </div>
                                    <span class="badge bg-outline-primary border text-primary px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>Asignado
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Card 4: Historial de Estados (Línea de Tiempo) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 text-secondary fw-bold">
                        <i class="bi bi-clock-history me-2"></i>Historial de Estados
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.HistorialEstados.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-1 text-secondary"></i>
                            Sin historial de estados registrado.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha y Hora</th>
                                        <th>Estado Alcanzado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in Model.HistorialEstados.OrderByDescending(x => x.Fecha))
                                    {
                                        <tr>
                                            <td>@h.Fecha.ToString("dd/MM/yyyy HH:mm:ss") UTC</td>
                                            <td>
                                                <span class="badge bg-secondary px-2 py-1">
                                                    @h.SiniestroEstadoNombre
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Botón de Acción Inferior -->
    <div class="mt-4 pt-3 border-top text-end">
        <a asp-action="Index" class="btn btn-secondary px-4 py-2 fw-bold">
            <i class="bi bi-arrow-left me-1"></i>Volver al Listado Principal
        </a>
    </div>
</div>
